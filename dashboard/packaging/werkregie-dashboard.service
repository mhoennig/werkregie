# systemd user unit: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now werkregie-dashboard
[Unit]
Description=Werkregie-Dashboard (localhost)

[Service]
ExecStart=%h/Projekte/werkregie/dashboard/build/install/werkregie-dashboard/bin/werkregie-dashboard
# EnvironmentFile=%h/.config/werkregie/tokens.env   # e.g. WERKREGIE_TOKEN_HOSTSHARING=…
Restart=on-failure

[Install]
WantedBy=default.target
